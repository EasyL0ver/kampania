{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_md.py\"",
            "timeout": 30,
            "statusMessage": "Validating markdown..."
          }
        ]
      }
    ]
  }
}
